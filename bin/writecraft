#!/bin/sh
# Writecraft 安装与更新：从远端拉取仓库到本地缓存，再同步到各工具的技能目录。
set -eu

REPO="${WRITECRAFT_REPO:-git@github.com:Zong-Liang/writecraft.git}"
BRANCH="${WRITECRAFT_BRANCH:-main}"
HOME_DIR="${WRITECRAFT_HOME:-$HOME/.local/share/writecraft}"
TARGETS="${WRITECRAFT_TARGETS:-$HOME/.claude/skills $HOME/.agents/skills}"

usage() {
  cat <<EOF
用法：writecraft <命令>

  update   从远端拉取最新版本，并同步到已安装的技能目录
  version  显示本地缓存的版本与提交
  help     显示本说明

环境变量：
  WRITECRAFT_REPO     仓库地址（默认 ${REPO}）
  WRITECRAFT_BRANCH   分支（默认 ${BRANCH}）
  WRITECRAFT_HOME     本地缓存目录（默认 \$HOME/.local/share/writecraft）
  WRITECRAFT_TARGETS  技能目录列表，空格分隔（默认 ~/.claude/skills ~/.agents/skills）
EOF
}

die() {
  echo "writecraft: $*" >&2
  exit 1
}

fetch() {
  if [ -d "$HOME_DIR/.git" ]; then
    [ -z "$(git -C "$HOME_DIR" status --porcelain)" ] ||
      die "缓存目录 $HOME_DIR 有未提交的修改，已停止。请处理后重试。"
    git -C "$HOME_DIR" fetch --quiet --depth 1 origin "$BRANCH"
    git -C "$HOME_DIR" merge --quiet --ff-only FETCH_HEAD ||
      die "缓存目录 $HOME_DIR 无法快进到远端 ${BRANCH}，已停止。"
  elif [ -e "$HOME_DIR" ]; then
    die "$HOME_DIR 已存在但不是 git 仓库，已停止。"
  else
    mkdir -p "$(dirname "$HOME_DIR")"
    git clone --quiet --depth 1 --branch "$BRANCH" "$REPO" "$HOME_DIR"
  fi
}

sync_targets() {
  src="$HOME_DIR/skills/writecraft/"
  [ -f "${src}SKILL.md" ] || die "缓存中缺少 skills/writecraft/SKILL.md"
  synced=0
  for dir in $TARGETS; do
    # 只安装到已存在的工具目录，例如 ~/.claude 或 ~/.agents
    [ -d "$(dirname "$dir")" ] || continue
    dest="$dir/writecraft"
    if [ -L "$dest" ]; then
      echo "跳过 ${dest}：符号链接，内容随链接目标变化"
      continue
    fi
    mkdir -p "$dest"
    rsync -a --delete "$src" "$dest/"
    echo "已同步 $dest"
    synced=$((synced + 1))
  done
  [ "$synced" -gt 0 ] || echo "没有可同步的技能目录：$TARGETS"
}

show_version() {
  [ -d "$HOME_DIR/.git" ] || die "尚未安装，请先运行 writecraft update"
  version=$(sed -n 's/.*"version": *"\([^"]*\)".*/\1/p' "$HOME_DIR/skills/writecraft/version.json")
  echo "writecraft $version ($(git -C "$HOME_DIR" log -1 --format='%h %cs'))"
}

case "${1:-help}" in
  update)
    before=$(git -C "$HOME_DIR" rev-parse --short HEAD 2>/dev/null || echo "未安装")
    fetch
    after=$(git -C "$HOME_DIR" rev-parse --short HEAD)
    if [ "$before" = "$after" ]; then
      echo "已是最新：$after"
    else
      echo "已更新：$before -> $after"
    fi
    sync_targets
    ;;
  version) show_version ;;
  help | -h | --help) usage ;;
  *) usage >&2; exit 1 ;;
esac
